@page
@model SisReservaDeSalas.Web.Pages.Salas.CadastrarModel
@{
    ViewData["Title"] = "Cadastrar sala";
}
<section class="py-4 col-lg-7">
    <h1>Cadastrar sala</h1>
    <p>Informe os dados da sala. O campo de recursos é opcional.</p>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Cadastro.Identificacao" class="form-label">Identificação</label>
            <input asp-for="Cadastro.Identificacao" class="form-control" maxlength="100" />
            <span asp-validation-for="Cadastro.Identificacao" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Cadastro.Localizacao" class="form-label">Localização</label>
            <input asp-for="Cadastro.Localizacao" class="form-control" maxlength="150" />
            <span asp-validation-for="Cadastro.Localizacao" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Cadastro.Capacidade" class="form-label">Capacidade (pessoas)</label>
            <input asp-for="Cadastro.Capacidade" class="form-control" min="1" />
            <span asp-validation-for="Cadastro.Capacidade" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Cadastro.Recursos" class="form-label">Recursos disponíveis</label>
            <textarea asp-for="Cadastro.Recursos" class="form-control" rows="3" maxlength="500"></textarea>
            <span asp-validation-for="Cadastro.Recursos" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary">Salvar sala</button>
        <a asp-page="/Salas/Index" class="btn btn-outline-secondary">Cancelar</a>
    </form>
</section>
