<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Reserva de Salas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="visually-hidden-focusable" href="#conteudo">Ir para o conteúdo</a>
    <header class="border-bottom bg-white">
        <nav class="container py-3 d-flex flex-wrap gap-3 align-items-center justify-content-between" aria-label="Navegação principal">
            <a class="navbar-brand fw-semibold" asp-page="/Index">Reserva de Salas</a>
            <div class="d-flex gap-3 align-items-center">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-page="/Salas/Index">Salas</a>
                    <a asp-page="/Salas/Disponibilidade">Disponibilidade</a>
                    <a asp-page="/Reservas/Minhas">Minhas reservas</a>
                    <a asp-page="/Conta/Perfil">Minha conta</a>
                    <form method="post" asp-page="/Conta/Sair">
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Sair</button>
                    </form>
                }
                else
                {
                    <a asp-page="/Conta/Entrar">Entrar</a>
                }
            </div>
        </nav>
    </header>
    <main id="conteudo" class="container flex-grow-1">
        @RenderBody()
    </main>
    <footer class="border-top py-3 text-secondary">
        <div class="container">Sistema Web de Reserva de Salas Universitárias</div>
    </footer>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
