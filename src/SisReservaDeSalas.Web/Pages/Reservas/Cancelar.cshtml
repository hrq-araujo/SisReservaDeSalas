@page "{id:int}"
@model SisReservaDeSalas.Web.Pages.Reservas.CancelarModel
@{
    ViewData["Title"] = "Cancelar reserva";
}
<section class="py-4 col-lg-7">
    <h1>Cancelar reserva</h1>
    <dl>
        <dt>Sala</dt><dd>@Model.Reserva.Sala.Identificacao</dd>
        <dt>Data</dt><dd>@Model.Reserva.Inicio.ToString("dd/MM/yyyy")</dd>
        <dt>Horário</dt><dd>@Model.Reserva.Inicio.ToString("HH:mm") às @Model.Reserva.Fim.ToString("HH:mm") (Maringá)</dd>
        <dt>Finalidade</dt><dd>@Model.Reserva.Finalidade</dd>
    </dl>
    @if (Model.Reserva.Ativa)
    {
        <p>Deseja cancelar esta reserva? O horário ficará disponível para novas reservas.</p>
        <form method="post" asp-route-id="@Model.Reserva.Id">
            <button type="submit" class="btn btn-danger">Confirmar cancelamento</button>
            <a asp-page="/Reservas/Minhas" class="btn btn-outline-secondary">Voltar</a>
        </form>
    }
    else
    {
        <p>Esta reserva já foi cancelada.</p>
        <a asp-page="/Reservas/Minhas">Voltar para minhas reservas</a>
    }
</section>
