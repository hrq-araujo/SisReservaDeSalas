@page "{id:int}"
@model SisReservaDeSalas.Web.Pages.Reservas.ConfirmacaoModel
@{
    ViewData["Title"] = "Reserva confirmada";
}
<section class="py-4">
    <h1>Reserva confirmada</h1>
    <dl>
        <dt>Sala</dt><dd>@Model.Reserva.Sala.Identificacao</dd>
        <dt>Data</dt><dd>@Model.Reserva.Inicio.ToString("dd/MM/yyyy")</dd>
        <dt>Horário</dt><dd>@Model.Reserva.Inicio.ToString("HH:mm") às @Model.Reserva.Fim.ToString("HH:mm") (Maringá)</dd>
        <dt>Finalidade</dt><dd>@Model.Reserva.Finalidade</dd>
    </dl>
    <a asp-page="/Salas/Disponibilidade">Consultar outro horário</a>
</section>
