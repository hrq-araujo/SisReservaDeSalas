@page
@model ErrorModel
@{
    ViewData["Title"] = "Erro";
}
<section class="py-5">
    <h1>Não foi possível concluir a solicitação.</h1>
    <p>Tente novamente em alguns instantes.</p>
    @if (Model.ShowRequestId)
    {
        <p>Identificador da solicitação: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index">Voltar ao início</a>
</section>
