@page
@model SisReservaDeSalas.Web.Pages.Conta.EntrarModel
@{
    ViewData["Title"] = "Entrar";
}
<div class="row py-5">
    <section class="col-md-6 col-lg-4">
        <h1>Entrar</h1>
        <p>Use sua conta cadastrada no sistema.</p>
        <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Entrada.Email" class="form-label">E-mail</label>
                <input asp-for="Entrada.Email" type="email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Entrada.Email" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Entrada.Senha" class="form-label">Senha</label>
                <input asp-for="Entrada.Senha" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Entrada.Senha" class="text-danger"></span>
            </div>
            <button class="btn btn-primary" type="submit">Entrar</button>
        </form>
    </section>
</div>
